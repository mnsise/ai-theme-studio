{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"permalink_structure": "/%postname%/",
				"WPLANG": ""
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "elementor"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "ai-theme-studio/ai-theme-studio.php"
		}
	]
}
